PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX_MERCHANT_EMAIL=
PAYPAL_SANDBOX_CUSTOMER_EMAIL=
PAYPAL_ENVIRONMENT=SANDBOX
PAYPAL_WEBHOOK_ID=
POLICY_MODE=dry_run
# 10.3: true runs the API and worker with no PayPal at all (every action a dry run, PayPal webhooks refused,
# no invoice polling). Use it for the demo or a machine without PayPal credentials.
BOOMERANG_OFFLINE=false
PAY_LINK_SECRET=
SIM_WEBHOOK_SECRET=
DATABASE_URL=postgres://boomerang:boomerang@localhost:5432/boomerang
# Optional: a separate database for the tests (default: DATABASE_URL). Keeps test rows out of your data.
TEST_DATABASE_URL=
# Optional: the API's port (default 3000), and where the dashboard finds the API (default http://localhost:3000).
# PORT=3000
# VITE_API_URL=http://localhost:3000
# Optional, local only: the Render database's external URL, for read-only inspection and demo-1 runs.
RENDER_DATABASE_URL=
GROQ_API_KEY=
# Optional, local only: extra keys from teammates' own Groq organizations, comma-separated.
# Simulations and evals rotate across them; the deployed worker uses GROQ_API_KEY alone.
GROQ_API_KEYS=
GROQ_RPM=25

# Dashboard (6.1). Origins allowed to call the API, comma-separated (local Vite dev is always allowed
# outside production), and the shared secret the operator types into the dashboard to use /api.
DASHBOARD_ORIGINS=
OPERATOR_TOKEN=

# AG Grid Enterprise licence key for the dashboard (6.5). Also set on the Render static site.
VITE_AG_GRID_LICENSE_KEY=

# Bryntum Scheduler Enterprise licence key for the dashboard (8.2). Also set on the Render static site.
VITE_BRYNTUM_LICENSE_KEY=

# Pay page (7C): the public base URL the links point at, and the merchant name the page shows.
# Quote values that contain spaces.
PUBLIC_BASE_URL=
MERCHANT_NAME=
