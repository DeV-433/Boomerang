#!/usr/bin/env bash
# Local CI gate (BUILD_PLAN 1.2). GitHub Actions is unavailable on this account, and Render
# deploys on every push, so nothing reaches main unless lint, type-check and all tests pass here.
# Bypass only in an emergency: git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "pre-push: running local CI (lint, typecheck, migrate, tests)..."
if ! (set -a; [ -f .env ] && . ./.env; set +a; node -e '
  const u = new URL(process.env.TEST_DATABASE_URL || process.env.DATABASE_URL);
  require("net").connect(+u.port || 5432, u.hostname).on("connect", () => process.exit(0)).on("error", () => process.exit(1));
') 2>/dev/null; then
  echo "pre-push: local Postgres is not reachable. Start it with: npm run db:up" >&2
  exit 1
fi

export CI=true # database tests must run, never skip
npm run --silent lint
npm run --silent typecheck
npm run --silent db:migrate
npm test --silent
echo "pre-push: all checks passed."
